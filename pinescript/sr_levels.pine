//@version=5
// =============================================================================
// S/R Levels — Daily + 75-min swing highs/lows (multi-timeframe)
//
// Matches the manual method: mark swing highs/lows on the DAILY and the
// 75-MINUTE charts, then watch those levels while trading the 15-min.
//
//   - Daily swing highs (resistance) / lows (support)
//   - 75-min swing highs (resistance) / lows (support)
//   - both drawn as rays on the current (15-min) chart
//   - near-duplicate levels merged; a level is removed once price closes
//     through it; only the most recent N per side are kept
//
// Apply on a 15-minute index chart (Nifty / Bank Nifty).
// =============================================================================
indicator("S/R Levels — Daily + 75m swings", overlay = true, max_lines_count = 500, max_labels_count = 200)

// ---- Inputs -----------------------------------------------------------------
grpD = "Daily swings"
useD    = input.bool(true, "Use Daily swings", group = grpD)
dTf     = input.timeframe("D", "Daily timeframe", group = grpD)
dLeft   = input.int(2, "Daily left bars",  minval = 1, group = grpD)
dRight  = input.int(2, "Daily right bars", minval = 1, group = grpD)
dResCol = input.color(color.new(color.red,   0), "Daily resistance", group = grpD)
dSupCol = input.color(color.new(color.green, 0), "Daily support",    group = grpD)

grp75 = "75-min swings"
use75    = input.bool(true, "Use 75-min swings", group = grp75)
h75Tf    = input.timeframe("75", "Intraday timeframe", group = grp75)
h75Left  = input.int(3, "75m left bars",  minval = 1, group = grp75)
h75Right = input.int(3, "75m right bars", minval = 1, group = grp75)
h75ResCol= input.color(color.new(color.orange, 0), "75m resistance", group = grp75)
h75SupCol= input.color(color.new(color.aqua,   0), "75m support",    group = grp75)

grpC = "15-min (chart) swings"
useC     = input.bool(true, "Use current-chart swings", group = grpC)
cLeft    = input.int(5, "Chart left bars",  minval = 1, group = grpC)
cRight   = input.int(5, "Chart right bars", minval = 1, group = grpC)
cResCol  = input.color(color.new(color.maroon, 0), "Chart resistance", group = grpC)
cSupCol  = input.color(color.new(color.teal,   0), "Chart support",    group = grpC)

grpGen = "General"
maxLevels = input.int(6, "Max levels per side", minval = 1, maxval = 20, group = grpGen)
mergePct  = input.float(0.10, "Merge levels within %", step = 0.05, group = grpGen) / 100.0
removeBrk = input.bool(true, "Remove a level once price closes through it", group = grpGen)
showTag   = input.bool(true, "Label each level (D / 75 / 15)", group = grpGen)

// ---- Persistent level stores ------------------------------------------------
var array<line>  resL = array.new<line>()
var array<float> resP = array.new<float>()
var array<line>  supL = array.new<line>()
var array<float> supP = array.new<float>()

f_exists(arrP, price) =>
    bool found = false
    if array.size(arrP) > 0
        for i = 0 to array.size(arrP) - 1
            if math.abs(price - array.get(arrP, i)) / array.get(arrP, i) < mergePct
                found := true
    found

// Add a level (ray extending right) unless it duplicates one; cap the count.
f_add(arrL, arrP, price, col, tag) =>
    if not na(price) and not f_exists(arrP, price)
        ln = line.new(bar_index, price, bar_index + 1, price, color = col, width = 2, extend = extend.right)
        array.push(arrL, ln)
        array.push(arrP, price)
        if showTag
            label.new(bar_index, price, tag, style = label.style_none, textcolor = col, size = size.small)
        if array.size(arrL) > maxLevels
            line.delete(array.shift(arrL))
            array.shift(arrP)

// Each bar: drop any level price has closed through.
f_prune(arrL, arrP, isRes) =>
    int i = 0
    while i < array.size(arrL)
        price = array.get(arrP, i)
        broken = removeBrk and (isRes ? close > price : close < price)
        if broken
            line.delete(array.get(arrL, i))
            array.remove(arrL, i)
            array.remove(arrP, i)
        else
            i += 1

// ---- Pull higher-timeframe swing pivots -------------------------------------
// The pivot is confirmed `right` HTF-bars back, so these values are historical
// (no repaint / no future leak). lookahead_off keeps it honest.
phD  = request.security(syminfo.tickerid, dTf,   ta.pivothigh(dLeft,  dRight),  lookahead = barmerge.lookahead_off)
plD  = request.security(syminfo.tickerid, dTf,   ta.pivotlow(dLeft,   dRight),  lookahead = barmerge.lookahead_off)
ph75 = request.security(syminfo.tickerid, h75Tf, ta.pivothigh(h75Left, h75Right), lookahead = barmerge.lookahead_off)
pl75 = request.security(syminfo.tickerid, h75Tf, ta.pivotlow(h75Left,  h75Right), lookahead = barmerge.lookahead_off)

// Add each newly-confirmed pivot once.
if useD and not na(phD) and (na(phD[1]) or phD != phD[1])
    f_add(resL, resP, phD, dResCol, "D")
if useD and not na(plD) and (na(plD[1]) or plD != plD[1])
    f_add(supL, supP, plD, dSupCol, "D")
if use75 and not na(ph75) and (na(ph75[1]) or ph75 != ph75[1])
    f_add(resL, resP, ph75, h75ResCol, "75")
if use75 and not na(pl75) and (na(pl75[1]) or pl75 != pl75[1])
    f_add(supL, supP, pl75, h75SupCol, "75")

// Current-chart (15-min) swings — no request.security needed.
phC = ta.pivothigh(cLeft, cRight)
plC = ta.pivotlow(cLeft,  cRight)
if useC and not na(phC)
    f_add(resL, resP, phC, cResCol, "15")
if useC and not na(plC)
    f_add(supL, supP, plC, cSupCol, "15")

f_prune(resL, resP, true)
f_prune(supL, supP, false)
